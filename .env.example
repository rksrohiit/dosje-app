# ─── Server ───────────────────────────────────────────────
# REQUIRED: Change this in production!
JWT_SECRET=dosje_super_secret_2024_change_in_prod

# Server port (default 5000)
PORT=5000

# Node environment
NODE_ENV=production

# ─── Client (Vite build-time) ─────────────────────────────
# Backend API URL for production (used during docker build)
# Leave empty if using Nginx proxy (recommended)
VITE_API_URL=

# ─── Optional: Email Alerts ───────────────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
# ALERT_EMAIL=dosje-alerts@gov.in
